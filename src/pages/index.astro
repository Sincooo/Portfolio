---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import ProfileVisual from '../components/ProfileVisual.astro';
import TechnologyMarquee from '../components/TechnologyMarquee.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import { projects } from '../data/projects';
import { cv } from '../data/site';
import { technologies } from '../data/technologies';

const seminars = [
  { title: 'The Role of AI in Education', subtitle: 'Balancing the Benefits and Risk of Using AI in Education', detail: 'Webinar participation · DICT Region V', date: 'MAY 2025', image: '/assets/certificate-ai-education-full.webp', thumbnail: '/assets/certificate-ai-education-thumb.webp', width: 1800, height: 1274, thumbnailHeight: 544 },
  { title: 'AI in English Teaching: Friend or Foe?', subtitle: 'Exploring the Benefits and Challenges While Keeping the Human Touch', detail: 'Webinar participation · National Teachers College', date: 'MAY 2025', image: '/assets/certificate-ai-english-full.webp', thumbnail: '/assets/certificate-ai-english-thumb.webp', width: 1800, height: 1273, thumbnailHeight: 543 },
  { title: 'Safeguarding the Future', subtitle: 'Data Privacy and Cybersecurity in Education', detail: 'Webinar participation · National Teachers College', date: 'WEBINAR', image: '/assets/certificate-cybersecurity-full.webp', thumbnail: '/assets/certificate-cybersecurity-thumb.webp', width: 1800, height: 1273, thumbnailHeight: 543 },
];
---
<BaseLayout>
  <Nav />
  <main id="main">
    <section id="home" class="hero section-shell">
      <div class="hero-statement">
        <p class="hero-greeting hero-enter" style="--enter-delay: 40ms">Hello, I am <span aria-hidden="true">↘</span></p>
        <h1 class="hero-name"><span class="hero-given"><span class="hero-word" style="--word-delay: 100ms">Edward Ranz</span></span><span class="hero-surname"><span class="hero-word" style="--word-delay: 180ms">CARDOZA</span></span></h1>
        <p class="hero-role hero-enter" style="--enter-delay: 190ms">Aspiring Software Engineer</p>
        <p class="hero-intro hero-enter" style="--enter-delay: 260ms">A Computer Science student curious about how systems work. I’m learning to build software and sharpening my programming skills, one step at a time.</p>
        <p class="hero-location hero-enter" style="--enter-delay: 310ms"><span aria-hidden="true">⌖</span> Cavite — Philippines</p>
        <div class="hero-actions hero-enter" style="--enter-delay: 330ms">
          <a class="button button-primary" href="#contact">Contact Me <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href="#projects">View Projects <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href={cv.url} download={cv.filename}>Download CV <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-socials hero-enter" style="--enter-delay: 380ms"><a href="https://github.com/Sincooo" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><span aria-hidden="true">/</span><a href="https://www.linkedin.com/in/edward-ranz-cardoza" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a></div>
      </div>
      <ProfileVisual />
      <div class="hero-footer"><p>COMPUTER SCIENCE <span aria-hidden="true">/</span> CVSU MAIN CAMPUS</p><a href="#technologies">Explore my journey <span aria-hidden="true">↓</span></a></div>
    </section>

    <section id="technologies" class="section-shell section-technologies">
      <div class="split-heading" data-reveal data-motion="sequence"><p class="eyebrow" data-motion-step>01 / LANGUAGES & TOOLS</p><h2 data-motion-step="primary" style="--step-delay: 90ms">TECHNOLOGIES</h2><p data-motion-step style="--step-delay: 190ms">The story behind what I’ve learned matters more than a percentage. These are foundations I’m developing—not claims of expertise.</p></div>
      <TechnologyMarquee technologies={technologies} />
    </section>

    <section id="projects" class="section-shell section-projects">
      <div class="section-heading project-heading" data-reveal data-motion="sequence"><p class="eyebrow" data-motion-step>02 / SELECTED WORK</p><h2 data-motion-step="primary" style="--step-delay: 90ms">PROJECT<br /><span>FOLDERS</span></h2><p data-motion-step style="--step-delay: 190ms">A selection of public repositories from my learning journey.</p></div>
      <ProjectShowcase projects={projects} />
    </section>

    <section id="about" class="section-about">
      <div class="section-shell about-grid">
        <div class="about-portrait" data-reveal data-motion="media">
          <div class="about-image-mask"><img src="/assets/portrait-700.webp" srcset="/assets/portrait-350.webp 350w, /assets/portrait-700.webp 700w" sizes="(max-width: 700px) 88vw, 34vw" alt="Edward Ranz Cardoza in Cavite, Philippines" width="700" height="1050" loading="lazy" decoding="async" /></div>
          <span class="about-orbit" aria-hidden="true">✳</span>
        </div>
        <div class="about-copy">
          <p class="eyebrow" data-reveal>03 / ABOUT</p>
          <h2 data-reveal data-motion="primary">CURIOUS BY<br /><em>default</em></h2>
          <p data-reveal>I’m a Computer Science student at Cavite State University – Main Campus, building my foundation in software development through Java and other languages introduced through coursework. I’m interested in AI engineering and cloud engineering, while remaining open to exploring different environments and sectors of technology. I value steady progress, learning, and mastering the fundamentals.</p>
          <dl class="about-facts" data-reveal>
            <div><dt>Based in</dt><dd>Cavite, Philippines</dd></div>
            <div><dt>Interested in</dt><dd>AI and cloud engineering</dd></div>
            <div><dt>Direction</dt><dd>Software engineering</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section id="education" class="section-shell section-education">
      <div class="education-heading" data-reveal data-motion="sequence"><p class="eyebrow" data-motion-step>04 / EDUCATION</p><h2 data-motion-step="primary" style="--step-delay: 90ms">THE<br /><span>FOUNDATION</span></h2></div>
      <ol class="education-timeline">
        <li class="education-stage"><article class="education-card" data-reveal data-motion="sequence"><span class="education-step-number" aria-hidden="true">01</span><div class="education-mark" data-motion-step style="--step-delay: 110ms"><img src="/assets/cvsu-logo.png" alt="Cavite State University official logo" width="200" height="174" loading="lazy" /></div><div class="education-details"><p class="eyebrow" data-motion-step style="--step-delay: 160ms">2025 — PRESENT</p><h3 data-motion-step style="--step-delay: 210ms">Bachelor of Science in Computer Science</h3><p data-motion-step style="--step-delay: 260ms">Cavite State University<br />Main Campus</p></div><div class="education-foot" data-motion-step style="--step-delay: 330ms">LEARNING IN PROGRESS <span aria-hidden="true">↗</span></div></article></li>
        <li class="education-stage"><article class="education-card" data-reveal data-motion="sequence"><span class="education-step-number" aria-hidden="true">02</span><div class="education-mark" data-motion-step style="--step-delay: 110ms"><img src="/assets/pcu-logo.png" alt="Philippine Christian University official seal" width="300" height="298" loading="lazy" decoding="async" /></div><div class="education-details"><p class="eyebrow" data-motion-step style="--step-delay: 160ms">2023 — 2025</p><h3 data-motion-step style="--step-delay: 210ms">Senior High School</h3><p data-motion-step style="--step-delay: 260ms">Philippine Christian University<br />Dasmariñas</p></div><div class="education-foot" data-motion-step style="--step-delay: 330ms">SENIOR HIGH SCHOOL <span aria-hidden="true">↗</span></div></article></li>
      </ol>
    </section>

    <section id="experience" class="section-experience">
      <div class="section-shell experience-layout">
        <div class="experience-intro" data-reveal data-motion="sequence"><p class="eyebrow" data-motion-step>05 / EXPERIENCE</p><h2 data-motion-step="primary" style="--step-delay: 90ms">LEARNING<br />BEYOND<br /><em>the classroom</em></h2><p data-motion-step style="--step-delay: 190ms">Experience is also the questions you ask and the conversations you join. These seminars are part of how I continue exploring technology and its impact.</p></div>
        <div class="experience-list">
          {seminars.map((seminar, index) => <article class="experience-item" data-reveal data-motion="card" style={`--reveal-delay: ${index * 85}ms`}>
            <span class="experience-index">0{index + 1}</span>
            <div><p class="eyebrow">{seminar.date} / {seminar.detail}</p><h3>{seminar.title}</h3><p>{seminar.subtitle}</p></div>
            <a href="#gallery" aria-label={`View certificates in gallery for ${seminar.title}`}>↗</a>
          </article>)}
        </div>
      </div>
    </section>

    <section id="gallery" class="section-shell section-gallery">
      <div class="split-heading" data-reveal data-motion="sequence"><p class="eyebrow" data-motion-step>06 / GALLERY</p><h2 data-motion-step="primary" style="--step-delay: 90ms">A VISUAL<br /><span>RECORD</span></h2><p data-motion-step style="--step-delay: 190ms">A place for the work, moments, and milestones that shape my path. For now, these certificates document seminars I’ve attended.</p></div>
      <div class="gallery-subhead"><h3>Certificates</h3><span>01 — 03</span></div>
      <div class="gallery-grid">
        {seminars.map((seminar, index) => <button class="gallery-item" type="button" data-gallery-index={index} data-reveal data-motion="card" style={`--reveal-delay: ${index * 90}ms`} aria-label={`Open certificate: ${seminar.title}`}>
          <span class="gallery-image"><img src={seminar.thumbnail} alt={`Certificate of participation for ${seminar.title}`} width="768" height={seminar.thumbnailHeight} loading="lazy" decoding="async" /></span>
          <span class="gallery-caption"><span>0{index + 1} / CERTIFICATE</span><strong>{seminar.title}</strong><span aria-hidden="true">↗</span></span>
        </button>)}
      </div>
    </section>

    <section id="github" class="section-shell section-github">
      <GitHubActivity />
    </section>

    <section class="section-quote" aria-labelledby="quote-heading">
      <figure class="personal-quote section-shell" data-reveal data-motion="sequence">
        <figcaption class="eyebrow" id="quote-heading" data-motion-step>A PERSONAL REMINDER</figcaption>
        <span class="quote-mark" aria-hidden="true" data-motion-step style="--step-delay: 90ms">“</span>
        <blockquote data-motion-step="primary" style="--step-delay: 160ms">A man's pain when doing something he loves isn't pain, but an obstacle</blockquote>
      </figure>
    </section>

    <section id="contact" class="section-contact">
      <div class="section-shell contact-inner" data-reveal data-motion="sequence">
        <p class="eyebrow" data-motion-step>08 / CONTACT</p>
        <h2 data-motion-step="primary" style="--step-delay: 90ms">LET’S BUILD<br /><span>SOMETHING TOGETHER</span></h2>
        <p data-motion-step style="--step-delay: 190ms">Interested in connecting, sharing ideas, or following what I’m learning? My inbox and profiles are open.</p>
        <a class="contact-email" data-motion-step style="--step-delay: 260ms" href="mailto:cardozaedwardranz14@gmail.com">cardozaedwardranz14@gmail.com <span aria-hidden="true">↗</span></a>
        <div class="contact-links" data-motion-step style="--step-delay: 320ms"><a href="https://github.com/Sincooo" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/edward-ranz-cardoza" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://www.facebook.com/ranz.edward.92" target="_blank" rel="noopener noreferrer">Facebook ↗</a></div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="section-shell site-footer-inner">
      <a class="footer-brand" href="#home">RANZ</a>
      <nav aria-label="Footer links"><a href={cv.url} download={cv.filename}>CV ↓</a><a href="https://github.com/Sincooo" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/edward-ranz-cardoza" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></nav>
      <a class="footer-top" href="#home">Back to top ↑</a>
      <p>© {new Date().getFullYear()} Edward Ranz V. Cardoza</p>
    </div>
  </footer>

  <dialog id="gallery-dialog" class="gallery-dialog" aria-label="Certificate preview">
    <div class="dialog-bar"><span id="dialog-count"></span><button type="button" id="dialog-close" aria-label="Close preview">✕</button></div>
    <div class="dialog-image"><img id="dialog-img" alt="" /></div>
    <div class="dialog-bottom"><button type="button" id="dialog-prev" aria-label="Previous certificate">←</button><p id="dialog-title"></p><button type="button" id="dialog-next" aria-label="Next certificate">→</button></div>
  </dialog>
  <script define:vars={{ gallery: seminars.map(({ title, image, width, height }) => ({ title, image, width, height })) }}>
    const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
    const dialog = document.getElementById('gallery-dialog');
    const dialogImage = document.getElementById('dialog-img');
    const dialogTitle = document.getElementById('dialog-title');
    const dialogCount = document.getElementById('dialog-count');
    let selected = 0;
    let opener = null;
    let closeTimer;
    const closePreview = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      if (motionPreference.matches) { dialog.close(); return; }
      dialog.classList.add('is-closing');
      closeTimer = setTimeout(() => dialog.close(), 160);
    };
    const show = (index) => { selected = (index + gallery.length) % gallery.length; dialogImage.width = gallery[selected].width; dialogImage.height = gallery[selected].height; dialogImage.src = gallery[selected].image; dialogImage.alt = `Certificate of participation for ${gallery[selected].title}`; dialogTitle.textContent = gallery[selected].title; dialogCount.textContent = `CERTIFICATE 0${selected + 1} / 0${gallery.length}`; };
    document.querySelectorAll('[data-gallery-index]').forEach((button) => button.addEventListener('click', () => { clearTimeout(closeTimer); opener = button; show(Number(button.dataset.galleryIndex)); dialog.classList.remove('is-closing'); dialog.showModal(); document.body.classList.add('modal-open'); document.getElementById('dialog-close').focus(); }));
    document.getElementById('dialog-close').addEventListener('click', closePreview);
    document.getElementById('dialog-prev').addEventListener('click', () => show(selected - 1));
    document.getElementById('dialog-next').addEventListener('click', () => show(selected + 1));
    dialog.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft') show(selected - 1); if (event.key === 'ArrowRight') show(selected + 1); });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) closePreview(); });
    dialog.addEventListener('cancel', (event) => { event.preventDefault(); closePreview(); });
    dialog.addEventListener('close', () => { clearTimeout(closeTimer); dialog.classList.remove('is-closing'); document.body.classList.remove('modal-open'); opener?.focus(); });
  </script>
</BaseLayout>
