---
import '@fontsource-variable/inter';
import '@fontsource-variable/sora';
import '../styles/global.css';
import '../styles/sections.css';
import '../styles/themes.css';
import '../styles/phase2.css';
import '../styles/motion.css';
import '../styles/refinements.css';
import ContrastCursor from '../components/ContrastCursor.astro';
import PageLoader from '../components/PageLoader.astro';
import MotionController from '../components/MotionController.astro';

const {
  title = 'Edward Ranz Cardoza — Aspiring Software Engineer',
  description = 'Edward Ranz Cardoza, a Computer Science student at Cavite State University, learning to build software and understand how systems work.',
  showLoader = Astro.url.pathname === '/',
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark" data-home-loader={showLoader ? 'true' : 'false'}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        let theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        try { const saved = localStorage.getItem('portfolio-theme'); if (saved === 'dark' || saved === 'light') theme = saved; } catch {}
        document.documentElement.dataset.theme = theme;
        const homeLoader = document.documentElement.dataset.homeLoader === 'true';
        let alreadyShown = false;
        try { alreadyShown = sessionStorage.getItem('portfolio-loader-shown') === 'true'; } catch {}
        if (homeLoader && !alreadyShown && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('page-loading');
        } else {
          document.documentElement.classList.add('page-ready');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c1017" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    {showLoader && <PageLoader />}
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <MotionController />
    <ContrastCursor />
  </body>
</html>
