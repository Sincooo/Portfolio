<div class="page-loader" aria-hidden="true">
  <div class="loader-mark">
    <span class="loader-kicker">PORTFOLIO / 2026</span>
    <span class="loader-word">RANZ</span>
    <span class="loader-line"><i></i></span>
    <span class="loader-status">LOADING THE WORK</span>
  </div>
</div>
<script>
  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>('.page-loader');
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  if (loader && root.classList.contains('page-loading')) {
    let leaving = false;
    let exitTimer = 0;
    let assetTimer = 0;
    const complete = () => {
      window.clearTimeout(exitTimer);
      window.clearTimeout(assetTimer);
      root.classList.remove('page-loading', 'page-revealing');
      root.classList.add('page-ready');
      try { sessionStorage.setItem('portfolio-loader-shown', 'true'); } catch {}
      motion.removeEventListener('change', onMotionChange);
    };
    const finish = () => {
      if (!root.classList.contains('page-loading')) return;
      if (motion.matches) { complete(); return; }
      if (leaving) return;
      leaving = true;
      loader.classList.add('is-leaving');
      root.classList.add('page-revealing');
      exitTimer = window.setTimeout(complete, 420);
    };
    const onMotionChange = (event: MediaQueryListEvent) => { if (event.matches) finish(); };
    const portrait = document.querySelector<HTMLImageElement>('.portrait-frame img');
    const assets = Promise.allSettled([document.fonts.ready, portrait?.decode().catch(() => {})]);
    const assetLimit = new Promise(resolve => { assetTimer = window.setTimeout(resolve, 4500); });
    // Loading follows asset readiness without a minimum delay.
    void Promise.race([assets, assetLimit]).then(finish);
    motion.addEventListener('change', onMotionChange);
  }
</script>
