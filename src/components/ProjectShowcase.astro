---
import type { Project } from '../data/projects';
import '../styles/project-showcase.css';

const { projects } = Astro.props as { projects: Project[] };
const projectAccents = ['#4f75ff', '#8b67e8', '#df764f'];
---
<div class="project-showcase" data-project-showcase style={`--scene-accent: ${projectAccents[0]}`}>
  <div class="project-controls" data-reveal>
    <div class="project-controls__intro">
      <p class="project-controls__label">Selected work</p>
    </div>

    <div class="project-controls__navigation">
      <button type="button" data-project-previous aria-label="Show previous project">
        <span aria-hidden="true">←</span>
      </button>
      <div class="project-controls__position" aria-hidden="true">
        <span><strong data-project-current>01</strong> / {String(projects.length).padStart(2, '0')}</span>
        <i><b data-project-progress></b></i>
      </div>
      <button type="button" data-project-next aria-label="Show next project">
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>

  <p class="project-showcase__announcement sr-only" data-project-announcement role="status" aria-live="polite" aria-atomic="true"></p>

  <div class="project-folder-viewport" data-project-viewport tabindex="0" role="region" aria-roledescription="carousel" aria-label={`Selected projects, ${projects.length} items. Use left and right arrow keys to browse.`}>
    <div class="project-folder-track" data-project-track>
      {projects.map((project, index) => (
        <article
          class:list={['project-folder', { 'is-active': index === 0 }]}
          data-project-card
          data-index={index}
          data-position={index === 0 ? 'active' : 'after'}
          data-accent={projectAccents[index % projectAccents.length]}
          aria-label={`${project.title}, project ${index + 1} of ${projects.length}`}
          style={`--project-index: ${index}; --card-accent: ${projectAccents[index % projectAccents.length]}`}
        >
          <span class="project-folder-tab" aria-hidden="true">PROJECT {String(index + 1).padStart(2, '0')}</span>

          <div class="project-folder-inner">
            <div class="project-folder-copy">
              <div class="project-folder-meta">
                <span>{String(index + 1).padStart(2, '0')} / {project.status}</span>
                <span>{project.category}</span>
              </div>

              <h3>{project.title}</h3>
              <p class="project-folder-summary">{project.summary || 'No description has been provided for this repository.'}</p>

              <dl>
                <div><dt>Repository</dt><dd>{project.repositoryName}</dd></div>
                <div><dt>Primary language</dt><dd>{project.primaryLanguage || 'Not listed on GitHub'}</dd></div>
              </dl>

              <a class="project-folder-link" href={`/projects/${project.slug}/`} target="_blank" rel="noopener noreferrer" aria-label={`View project: ${project.title} (opens in a new tab)`}>
                View project <span aria-hidden="true">↗</span>
              </a>
            </div>

            <div class="project-folder-media" aria-hidden="true">
              <div class="project-folder-preview">
                <div class="project-preview-grid"></div>
                <div class="project-preview-orbit"><i></i><i></i></div>
                <span class="project-preview-monogram">{project.title.slice(0, 2).toUpperCase()}</span>
                <span class="project-preview-repository">{project.repositoryName}</span>
                <i class="project-preview-line project-preview-line--one"></i>
                <i class="project-preview-line project-preview-line--two"></i>
                <i class="project-preview-line project-preview-line--three"></i>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-project-showcase]').forEach((showcase) => {
    const viewport = showcase.querySelector<HTMLElement>('[data-project-viewport]');
    const track = showcase.querySelector<HTMLElement>('[data-project-track]');
    const cards = [...showcase.querySelectorAll<HTMLElement>('[data-project-card]')];
    const current = showcase.querySelector<HTMLElement>('[data-project-current]');
    const progress = showcase.querySelector<HTMLElement>('[data-project-progress]');
    const announcement = showcase.querySelector<HTMLElement>('[data-project-announcement]');
    const previous = showcase.querySelector<HTMLButtonElement>('[data-project-previous]');
    const next = showcase.querySelector<HTMLButtonElement>('[data-project-next]');

    if (!viewport || !track || !current || !progress || !previous || !next || cards.length === 0) return;

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;
    let frame = 0;
    let pointer: number | null = null;
    let startX = 0;
    let startScroll = 0;
    let moved = false;
    let hasAnnounced = false;

    const setActive = (index: number, announce = false) => {
      active = Math.max(0, Math.min(cards.length - 1, index));

      cards.forEach((card, cardIndex) => {
        const isActive = cardIndex === active;
        card.classList.toggle('is-active', isActive);
        card.dataset.position = isActive ? 'active' : cardIndex < active ? 'before' : 'after';
        if (isActive) card.setAttribute('aria-current', 'true');
        else card.removeAttribute('aria-current');
      });

      const activeCard = cards[active];
      showcase.style.setProperty('--scene-accent', activeCard.dataset.accent || '#4f75ff');
      showcase.dataset.active = String(active);
      current.textContent = String(active + 1).padStart(2, '0');
      progress.style.transform = `scaleX(${(active + 1) / cards.length})`;
      previous.disabled = active === 0;
      next.disabled = active === cards.length - 1;

      if (announcement && announce && hasAnnounced) {
        const heading = activeCard.querySelector('h3')?.textContent?.trim() || `Project ${active + 1}`;
        announcement.textContent = `Showing project ${active + 1} of ${cards.length}: ${heading}.`;
      }
      hasAnnounced = true;
    };

    const updateFromScroll = () => {
      frame = 0;
      const center = viewport.scrollLeft + viewport.clientWidth / 2;
      const nearest = cards.reduce((closest, card, index) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const closestCenter = cards[closest].offsetLeft + cards[closest].offsetWidth / 2;
        return Math.abs(cardCenter - center) < Math.abs(closestCenter - center) ? index : closest;
      }, 0);
      if (nearest !== active) setActive(nearest, true);
    };

    const queueUpdate = () => {
      if (!frame) frame = requestAnimationFrame(updateFromScroll);
    };

    const setEdgeSpace = () => {
      const edgeSpace = Math.max(4, (viewport.clientWidth - cards[0].offsetWidth) / 2);
      track.style.setProperty('--project-edge-space', `${edgeSpace}px`);
      queueUpdate();
    };

    const go = (index: number) => {
      const targetIndex = Math.max(0, Math.min(cards.length - 1, index));
      const card = cards[targetIndex];
      viewport.scrollTo({
        left: card.offsetLeft - (viewport.clientWidth - card.offsetWidth) / 2,
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    };

    viewport.addEventListener('scroll', queueUpdate, { passive: true });

    viewport.addEventListener('wheel', (event) => {
      if (!event.shiftKey || Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
      event.preventDefault();
      viewport.scrollLeft += event.deltaY;
    }, { passive: false });

    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      if (event.target instanceof Element && event.target.closest('a, button, input, select, textarea, summary')) return;
      pointer = event.pointerId;
      startX = event.clientX;
      startScroll = viewport.scrollLeft;
      moved = false;
      viewport.setPointerCapture(event.pointerId);
      viewport.classList.add('is-dragging');
    });

    viewport.addEventListener('pointermove', (event) => {
      if (pointer !== event.pointerId || !viewport.hasPointerCapture(event.pointerId)) return;
      const distance = event.clientX - startX;
      if (Math.abs(distance) > 6) moved = true;
      viewport.scrollLeft = startScroll - distance;
    });

    const release = (event: PointerEvent) => {
      if (pointer !== event.pointerId) return;
      if (viewport.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId);
      pointer = null;
      viewport.classList.remove('is-dragging');
      queueUpdate();
      if (moved) window.setTimeout(() => { moved = false; }, 0);
    };

    viewport.addEventListener('pointerup', release);
    viewport.addEventListener('pointercancel', release);
    viewport.addEventListener('lostpointercapture', () => {
      pointer = null;
      viewport.classList.remove('is-dragging');
    });

    viewport.addEventListener('click', (event) => {
      if (!moved) return;
      event.preventDefault();
      event.stopPropagation();
      moved = false;
    }, true);

    previous.addEventListener('click', () => go(active - 1));
    next.addEventListener('click', () => go(active + 1));

    cards.forEach((card, index) => card.addEventListener('focusin', () => {
      if (active !== index) go(index);
    }));

    viewport.addEventListener('keydown', (event) => {
      if (event.target !== viewport) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); go(active - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); go(active + 1); }
      if (event.key === 'Home') { event.preventDefault(); go(0); }
      if (event.key === 'End') { event.preventDefault(); go(cards.length - 1); }
    });

    if ('IntersectionObserver' in window) {
      const viewObserver = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) showcase.classList.add('is-in-view');
      }, { threshold: 0.18 });
      viewObserver.observe(showcase);
    } else {
      showcase.classList.add('is-in-view');
    }

    if (typeof ResizeObserver === 'function') {
      const resizeObserver = new ResizeObserver(setEdgeSpace);
      resizeObserver.observe(viewport);
    } else {
      window.addEventListener('resize', setEdgeSpace, { passive: true });
    }
    setEdgeSpace();
    setActive(0);
  });
</script>
