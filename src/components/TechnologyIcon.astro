---
interface Props { name: string }
const { name } = Astro.props;

const icons: Record<string, string> = {
  Java: '/assets/technology/java-coffee-cup.svg',
  HTML: '/assets/technology/html5.svg',
  CSS: '/assets/technology/css3.svg',
  JavaScript: '/assets/technology/javascript.svg',
  Python: '/assets/technology/python.svg',
  'Visual Basic': '/assets/technology/visual-basic.svg',
};

const icon = icons[name];
const className = name.toLowerCase().replace(/\s+/g, '-');
---
<span class={`technology-icon icon-${className}`} aria-hidden="true">
  {icon && <img src={icon} alt="" width="64" height="64" loading="lazy" decoding="async" />}
</span>
