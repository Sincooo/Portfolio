---
const items = [
  { label: 'Technologies', href: '/#technologies', icon: '⌘' },
  { label: 'Projects', href: '/#projects', icon: '□' },
  { label: 'About', href: '/#about', icon: '◉' },
  { label: 'Contact', href: '/#contact', icon: '↗' },
];
---
<a class="portfolio-brand" href="/#home" aria-label="Edward Ranz Cardoza — Home"><img src="/favicon.svg" alt="" width="32" height="32" /><span>ERC<span class="brand-dot">.</span></span></a>
<header class="site-header section-shell">
  <nav class="desktop-nav" aria-label="Primary navigation">
    {items.map((item) => <a href={item.href}><span aria-hidden="true">{item.icon}</span><span>{item.label}</span></a>)}
  </nav>
  <nav class="mobile-nav" aria-label="Mobile navigation">
  <details>
    <summary>Menu <span aria-hidden="true">☰</span></summary>
    <div class="mobile-nav-links">{items.map((item) => <a href={item.href}>{item.label}</a>)}</div>
  </details>
  </nav>
</header>
