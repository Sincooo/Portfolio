---
const items = [
  { label: 'Home', href: '/#home', icon: '⌂' },
  { label: 'Projects', href: '/#projects', icon: '□' },
  { label: 'Technologies', href: '/#technologies', icon: '⌘' },
  { label: 'Experience', href: '/#experience', icon: '◷' },
  { label: 'Education', href: '/#education', icon: '▤' },
  { label: 'About', href: '/#about', icon: '◉' },
  { label: 'Gallery', href: '/#gallery', icon: '▧' },
  { label: 'Contact', href: '/#contact', icon: '↗' },
];
---
<nav class="desktop-nav" aria-label="Primary navigation">
  {items.map((item) => <a href={item.href} aria-label={item.label} title={item.label}><span aria-hidden="true">{item.icon}</span><span class="nav-tooltip">{item.label}</span></a>)}
</nav>
<nav class="mobile-nav" aria-label="Mobile navigation">
  <a class="mobile-brand" href="/#home">ERC<span>.</span></a>
  <details>
    <summary>Menu <span aria-hidden="true">☰</span></summary>
    <div class="mobile-nav-links">{items.map((item) => <a href={item.href}>{item.label}</a>)}</div>
  </details>
</nav>
