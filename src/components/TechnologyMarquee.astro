---
import TechnologyIcon from './TechnologyIcon.astro';
import type { Technology } from '../data/technologies';
import '../styles/technologies.css';

const { technologies } = Astro.props as { technologies: Technology[] };
const midpoint = Math.ceil(technologies.length / 2);
const rows = [technologies.slice(0, midpoint), technologies.slice(midpoint)];
---
<div class="technology-marquee" data-technology-marquee>
  <div class="technology-rows">
    {rows.map((row, rowIndex) => (
      <div class={`technology-row ${rowIndex % 2 ? 'is-reverse' : ''}`} data-technology-row>
        <div class="technology-track">
          {[false, true].map((duplicate) => (
            <div class="technology-set" aria-hidden={duplicate ? 'true' : undefined}>
              {row.map((technology) => (
                <button
                  class={`technology-pill ${technology.color}`}
                  type="button"
                  data-technology
                  data-name={technology.name}
                  data-tag={technology.tag}
                  data-summary={technology.summary}
                  data-story={technology.story}
                  data-next={technology.next}
                  tabindex={duplicate ? -1 : 0}
                  aria-pressed="false"
                >
                  <TechnologyIcon name={technology.name} />
                  <span>{technology.name}</span>
                  <small>{technology.tag}</small>
                </button>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <aside class="technology-info">
    <div class="technology-info-index" aria-hidden="true">↳</div>
    <div>
      <p class="technology-info-tag">LEARNING NOTES</p>
      <h3 class="technology-info-name">Tools I’m learning.</h3>
      <p class="technology-info-copy" hidden><span data-technology-copy-layout aria-hidden="true"></span><span data-technology-copy></span></p>
      <p class="technology-info-next" data-technology-next hidden></p>
      <p class="sr-only" data-technology-announcement aria-live="polite"></p>
    </div>
  </aside>
</div>

<script>
  const marquees = document.querySelectorAll<HTMLElement>('[data-technology-marquee]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  marquees.forEach((marquee) => {
    const tag = marquee.querySelector<HTMLElement>('.technology-info-tag')!;
    const name = marquee.querySelector<HTMLElement>('.technology-info-name')!;
    const copy = marquee.querySelector<HTMLElement>('[data-technology-copy]')!;
    const copyLayout = marquee.querySelector<HTMLElement>('[data-technology-copy-layout]')!;
    const copyContainer = copy.parentElement!;
    const panel = marquee.querySelector<HTMLElement>('.technology-info')!;
    const next = marquee.querySelector<HTMLElement>('[data-technology-next]')!;
    const announcement = marquee.querySelector<HTMLElement>('[data-technology-announcement]')!;
    const items = [...marquee.querySelectorAll<HTMLButtonElement>('[data-technology]')];
    let selected: HTMLButtonElement | null = null;
    let highlighted: HTMLButtonElement | null = null;
    let typingTimer = 0;
    let typingDelay = 0;
    let currentCopy = '';
    let panelAnimation: Animation | undefined;

    const updatePanel = (change: () => void) => {
      const previousHeight = panel.getBoundingClientRect().height;
      panelAnimation?.cancel();
      change();
      const nextHeight = panel.getBoundingClientRect().height;
      if (reduceMotion.matches || Math.abs(previousHeight - nextHeight) < 1) return;
      // Measure the actual selected story once; typing never changes its layout.
      panelAnimation = panel.animate([{ height: `${previousHeight}px` }, { height: `${nextHeight}px` }], {
        duration: 320, easing: 'cubic-bezier(.22,1,.36,1)',
      });
    };

    const stopTyping = () => { window.clearInterval(typingTimer); window.clearTimeout(typingDelay); };
    const typeCopy = (value: string) => {
      stopTyping();
      currentCopy = value;
      copyLayout.textContent = value;
      copyContainer.hidden = !value;
      copy.textContent = '';
      if (reduceMotion.matches) { copy.textContent = value; return; }
      let index = 0;
      typingDelay = window.setTimeout(() => {
        typingTimer = window.setInterval(() => {
          index += 2;
          copy.textContent = value.slice(0, index);
          if (index >= value.length) stopTyping();
        }, 18);
      }, 180);
    };
    const activate = (item: HTMLButtonElement, persist = false) => {
      if (highlighted === item) { if (persist) { selected = item; item.setAttribute('aria-pressed', 'true'); } return; }
      highlighted = item;
      items.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === item && persist)));
      items.forEach((candidate) => candidate.classList.toggle('is-selected', candidate === item));
      selected = persist ? item : null;
      marquee.querySelectorAll('[data-technology-row]').forEach((row) => row.classList.toggle('is-paused', row.contains(item)));
      const detail = `${item.dataset.summary} ${item.dataset.story}`;
      updatePanel(() => {
        marquee.classList.add('has-selection');
        tag.textContent = item.dataset.tag || '';
        name.textContent = item.dataset.name || '';
        next.textContent = item.dataset.next || '';
        next.hidden = !next.textContent;
        typeCopy(detail);
      });
      announcement.textContent = `${item.dataset.name}. ${item.dataset.tag}. ${detail} ${item.dataset.next}`;
      if (!reduceMotion.matches) {
        [tag, name, next].forEach((element, index) => {
          element.getAnimations().forEach((animation) => animation.cancel());
          element.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], {
            duration: 300, delay: index * 50, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'backwards',
          });
        });
      }
    };
    const reset = () => {
      if (selected) return;
      highlighted = null;
      stopTyping();
      marquee.querySelectorAll('[data-technology-row]').forEach((row) => row.classList.remove('is-paused'));
      items.forEach((candidate) => { candidate.setAttribute('aria-pressed', 'false'); candidate.classList.remove('is-selected'); });
      updatePanel(() => {
        marquee.classList.remove('has-selection');
        tag.textContent = 'LEARNING NOTES';
        name.textContent = 'Tools I’m learning.';
        copy.textContent = '';
        copyLayout.textContent = '';
        copyContainer.hidden = true;
        currentCopy = '';
        next.textContent = '';
        next.hidden = true;
      });
      announcement.textContent = '';
    };

    items.forEach((item) => {
      item.addEventListener('pointerdown', (event) => {
        if (item.closest('[aria-hidden="true"]')) event.preventDefault();
      });
      item.addEventListener('pointerenter', (event) => { if ((event as PointerEvent).pointerType === 'mouse') activate(item); });
      item.addEventListener('pointerleave', (event) => { if ((event as PointerEvent).pointerType === 'mouse') reset(); });
      item.addEventListener('focus', () => {
        if (!item.matches(':focus-visible')) return;
        // Keyboard visitors get a stationary, horizontally scrollable original row.
        // It stays stationary afterward so focus never resumes on a moving target.
        item.closest('[data-technology-row]')?.classList.add('is-keyboard');
        item.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' });
        activate(item, true);
      });
      item.addEventListener('blur', () => { selected = null; reset(); });
      item.addEventListener('click', (event) => {
        if (matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        event.stopPropagation();
        const shouldClose = selected === item;
        selected = null;
        if (shouldClose) reset(); else activate(item, true);
      });
    });
    document.addEventListener('pointerdown', (event) => {
      if (selected && event.target instanceof Element && event.target.closest('[data-technology]') !== selected) { selected = null; reset(); }
    });
    marquee.addEventListener('keydown', (event) => { if (event.key === 'Escape') { selected = null; reset(); } });
    reduceMotion.addEventListener('change', (event) => {
      panelAnimation?.cancel();
      if (event.matches && marquee.classList.contains('has-selection')) { stopTyping(); copy.textContent = currentCopy; }
    });
    window.addEventListener('resize', () => panelAnimation?.cancel(), { passive: true });
  });
</script>
